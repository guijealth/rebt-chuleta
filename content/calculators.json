    ]
   }
  },
  {
   "id": "paralelo",
   "title": "Resistencias en paralelo",
   "tex": "\\dfrac{1}{R_{eq}} = \\dfrac{1}{R_1} + \\dfrac{1}{R_2} + \\dots",
   "rows": [
    [
     "Todas las fórmulas",
     "Resistencias en paralelo"
    ],
    [
     "Todas las fórmulas",
     "Dos en paralelo"
    ]
   ],
   "inputs": [
    {
     "id": "R",
     "type": "list",
     "label": "Resistencias",
     "unit": "Ω",
     "min": 2
    }
   ],
   "outputs": [
    {
     "label": "R_eq",
     "expr": "1 / sum(R.map(x => 1 / x))",
     "unit": "Ω",
     "digits": 3
    }
   ],
   "example": {
    "R": [
     10,
     10,
     20
    ]
   }
  },
  {
