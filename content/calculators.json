 "calculators": [
  {
   "id": "ohm",
   "title": "Ley de Ohm",
   "tex": "V = R \\cdot I",
   "rows": [
    [
     "Todas las fórmulas",
     "Ley de Ohm"
    ]
   ],
   "inputs": [
    {
     "id": "V",
     "label": "Tensión V",
     "unit": "V",
     "optional": true
    },
    {
     "id": "R",
     "label": "Resistencia R",
     "unit": "Ω",
     "optional": true
    },
    {
     "id": "I",
     "label": "Intensidad I",
     "unit": "A",
     "optional": true
    }
   ],
   "outputs": [
    {
     "label": "V",
     "expr": "V ?? R * I",
     "unit": "V",
     "digits": 2
    },
    {
     "label": "R",
     "expr": "R ?? V / I",
     "unit": "Ω",
     "digits": 2
    },
    {
     "label": "I",
     "expr": "I ?? V / R",
     "unit": "A",
     "digits": 3
    }
   ],
   "example": {
    "V": 230,
    "R": 52.9
   },
   "note": "Rellena dos valores cualesquiera: se calcula el tercero."
  },
  {
   "id": "potencia_cc",
   "title": "Potencia en continua o resistiva",
   "tex": "P = V \\cdot I = R \\cdot I^2 = \\dfrac{V^2}{R}",
   "rows": [
    [
     "Todas las fórmulas",
     "Potencia (c.c. o resistiva)"
    ]
   ],
   "inputs": [
    {
     "id": "V",
     "label": "Tensión V",
     "unit": "V",
     "optional": true
    },
    {
     "id": "I",
     "label": "Intensidad I",
     "unit": "A",
     "optional": true
    },
    {
     "id": "R",
     "label": "Resistencia R",
     "unit": "Ω",
     "optional": true
    }
   ],
   "outputs": [
    {
     "label": "P",
     "expr": "V != null && I != null ? V * I : R != null && I != null ? R * I * I : V != null && R != null ? V * V / R : null",
     "unit": "W",
     "digits": 2
    }
   ],
   "example": {
    "V": 230,
    "I": 10
   },
   "note": "Rellena dos valores cualesquiera."
  },
  {
   "id": "energia",
   "title": "Energía consumida",
   "tex": "E = P \\cdot t",
   "rows": [
    [
     "Todas las fórmulas",
     "Energía consumida"
    ]
   ],
   "inputs": [
    {
     "id": "P",
     "label": "Potencia P",
     "unit": "W"
    },
    {
     "id": "t",
     "label": "Tiempo t",
     "unit": "h"
    }
   ],
   "outputs": [
    {
     "label": "E",
     "expr": "P * t",
     "unit": "Wh",
     "digits": 0
    },
    {
     "label": "E",
     "expr": "P * t / 1000",
     "unit": "kWh",
     "digits": 3
    }
   ],
   "example": {
    "P": 2000,
    "t": 3
   }
  },
  {
   "id": "joule",
   "title": "Calor por efecto Joule",
   "tex": "Q = R \\cdot I^2 \\cdot t",
   "rows": [
    [
     "Todas las fórmulas",
     "Calor por efecto Joule"
    ]
   ],
   "inputs": [
    {
     "id": "R",
     "label": "Resistencia R",
     "unit": "Ω"
    },
    {
     "id": "I",
     "label": "Intensidad I",
     "unit": "A"
    },
    {
     "id": "t",
     "label": "Tiempo t",
     "unit": "s"
    }
   ],
   "outputs": [
    {
     "label": "Q",
     "expr": "R * I * I * t",
     "unit": "J",
     "digits": 0
    }
   ],
   "example": {
    "R": 10,
    "I": 2,
    "t": 60
   }
  },
  {
