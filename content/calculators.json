  {
   "id": "serie",
   "title": "Resistencias en serie",
   "tex": "R_{eq} = R_1 + R_2 + \\dots",
   "rows": [
    [
     "Todas las fórmulas",
     "Resistencias en serie"
    ]
   ],
   "inputs": [
    {
     "id": "R",
